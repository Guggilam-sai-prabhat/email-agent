APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./mail_agent.db

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_CONTEXT_SIZE=8192

# Gmail OAuth client credentials go here once Gmail integration is added.
# Never commit real values — this file is a template only.
# GMAIL_TOKEN_FILE: if relative, resolved under ~/.config/mail-agent/ (outside
# the repo). Set an absolute path to control the location explicitly.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# Leave empty to skip label filtering and use the most recent inbox messages
# (capped by GMAIL_UNLABELED_MESSAGE_LIMIT). Set to a label name to restrict
# the agent to only messages carrying that label.
GMAIL_ALLOWED_LABEL=
GMAIL_UNLABELED_MESSAGE_LIMIT=10

EMAIL_MAX_AGE_DAYS=7
EMAIL_MAX_MESSAGES_PER_RUN=50
EMAIL_MAX_BODY_CHARACTERS=5000
INCLUDE_ATTACHMENTS=false

SCHEDULER_ENABLED=false
SCHEDULE_INTERVAL_MINUTES=30

# Set to true only to explicitly override the production safety checks
# (binding APP_HOST=0.0.0.0, or pointing OLLAMA_BASE_URL off localhost).
ALLOW_PUBLIC_BIND=false
